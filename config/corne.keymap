#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";
        colemak_dh {
            bindings = <
&kp TAB    &kp Q  &kp W  &kp F         &kp P      &kp G    &kp J  &kp L    &kp U      &kp Y    &kp SEMICOLON       &kp BSPC
&kp LSHFT  &kp A  &kp R  &kp S         &kp T      &kp D    &kp H  &kp N    &kp E      &kp I    &kp O               &mt RSHFT SQT
&kp LCTRL  &kp Z  &kp X  &kp C         &kp V      &kp B    &kp K  &kp M    &kp COMMA  &kp DOT  &mt RIGHT_ALT FSLH  &kp LGUI
                         &kp LEFT_ALT  &kp SPACE  &mo 1    &mo 2  &kp RET  &kp DEL
            >;
        };
        layer_1 {
            bindings = <
&kp ESCAPE  &kp N1    &kp N2          &kp N3          &kp N4           &kp N5      &kp N6    &kp N7     &kp N8     &kp N9     &kp N0          &trans
&trans      &mkp MB1  &mkp MCLK       &mmv MOVE_UP    &mkp MB2         &mkp MB4    &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &msc SCRL_UP    &trans
&trans      &trans    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp MB5    &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &msc SCRL_DOWN  &trans
                                      &trans          &trans           &trans      &kp RET   &kp RALT   &kp ESC
            >;
        };
        layer_2 {
            bindings = <
&trans        &kp EXCL         &kp AT           &kp HASH         &kp DLLR         &kp PRCNT          &kp CARET  &kp AMPS        &kp ASTRK  &kp LPAR  &kp RPAR  &trans
&kp CAPSLOCK  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_4  &kp KP_NUMBER_5    &kp MINUS  &kp EQUAL       &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&trans        &kp KP_NUMBER_6  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_NUMBER_0    &kp UNDER  &kp PLUS        &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                                                &kp ESC          &trans           &tog 3             &trans     &kp KP_NUMLOCK  &kp RALT
            >;
        };
        layer_3 {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans        &trans        &to 0           &trans  &trans  &trans
            >;
        };
    };
};

